{"type":"before","callId":"call@8","startTime":1161.911,"class":"Page","method":"addInitScript","params":{"source":"(({\n    serviceUUID,\n    pairedUUID,\n    serialUUID,\n    recordCommandUUID,\n    recordingStatusUUID,\n    recordingResultUUID,\n    serial,\n    paired\n  }) => {\n    const normalize = (uuid) => uuid.toLowerCase(), createWavBytes = () => {\n      const buffer = new ArrayBuffer(44), view = new DataView(buffer), encoder = new TextEncoder, writeString = (offset, value) => {\n        const bytes = encoder.encode(value);\n        for (let index = 0;index < bytes.length; index++)\n          view.setUint8(offset + index, bytes[index]);\n      };\n      writeString(0, \"RIFF\");\n      view.setUint32(4, 36, !0);\n      writeString(8, \"WAVE\");\n      writeString(12, \"fmt \");\n      view.setUint32(16, 16, !0);\n      view.setUint16(20, 1, !0);\n      view.setUint16(22, 1, !0);\n      view.setUint32(24, 16000, !0);\n      view.setUint32(28, 32000, !0);\n      view.setUint16(32, 2, !0);\n      view.setUint16(34, 16, !0);\n      writeString(36, \"data\");\n      view.setUint32(40, 0, !0);\n      return new Uint8Array(buffer);\n    };\n\n    class MockCharacteristic extends EventTarget {\n      readValueFactory;\n      onWrite;\n      value = null;\n      isNotifying = !1;\n      constructor(readValueFactory, onWrite) {\n        super();\n        this.readValueFactory = readValueFactory;\n        this.onWrite = onWrite;\n      }\n      async readValue() {\n        this.value = await this.readValueFactory();\n        return this.value;\n      }\n      async writeValueWithResponse(value) {\n        await this.onWrite?.(value);\n      }\n      async writeValue(value) {\n        await this.onWrite?.(value);\n      }\n      async startNotifications() {\n        this.isNotifying = !0;\n        return this;\n      }\n      async stopNotifications() {\n        this.isNotifying = !1;\n        return this;\n      }\n      emitValue(bytes) {\n        this.value = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);\n        this.dispatchEvent(new Event(\"characteristicvaluechanged\"));\n      }\n    }\n    const statusCharacteristic = new MockCharacteristic(async () => new DataView(Uint8Array.from([0]).buffer)), characteristics = new Map;\n    characteristics.set(normalize(serialUUID), new MockCharacteristic(async () => {\n      const bytes = new TextEncoder().encode(serial);\n      return new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);\n    }));\n    characteristics.set(normalize(pairedUUID), new MockCharacteristic(async () => {\n      return new DataView(Uint8Array.from([paired ? 1 : 0]).buffer);\n    }));\n    characteristics.set(normalize(recordingStatusUUID), statusCharacteristic);\n    characteristics.set(normalize(recordingResultUUID), new MockCharacteristic(async () => {\n      const bytes = createWavBytes();\n      return new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);\n    }));\n    characteristics.set(normalize(recordCommandUUID), new MockCharacteristic(async () => new DataView(new ArrayBuffer(0)), async () => {\n      setTimeout(() => {\n        statusCharacteristic.emitValue(Uint8Array.from([1]));\n      }, 50);\n      setTimeout(() => {\n        statusCharacteristic.emitValue(Uint8Array.from([2]));\n      }, 150);\n      setTimeout(() => {\n        statusCharacteristic.emitValue(Uint8Array.from([3]));\n      }, 250);\n    }));\n    const service = {\n      uuid: serviceUUID,\n      getCharacteristic: async (uuid) => {\n        const characteristic = characteristics.get(normalize(uuid));\n        if (!characteristic)\n          throw Error(`Unknown characteristic: ${uuid}`);\n        return characteristic;\n      }\n    };\n\n    class MockBluetoothDevice extends EventTarget {\n      id = \"mock-snsa-device\";\n      name = \"Mock SNSA Device\";\n      gatt = {\n        connected: !1,\n        connect: async () => {\n          this.gatt.connected = !0;\n          return this.gatt;\n        },\n        disconnect: () => {\n          if (!this.gatt.connected)\n            return;\n          this.gatt.connected = !1;\n          this.dispatchEvent(new Event(\"gattserverdisconnected\"));\n        },\n        getPrimaryService: async (uuid) => {\n          if (normalize(uuid) !== normalize(serviceUUID))\n            throw Error(`Unknown service: ${uuid}`);\n          return service;\n        }\n      };\n    }\n    const device = new MockBluetoothDevice;\n    Object.defineProperty(navigator, \"bluetooth\", {\n      configurable: !0,\n      value: {\n        requestDevice: async () => device,\n        getDevices: async () => [device]\n      }\n    });\n  })({\"serviceUUID\":\"55A7DC43-48C1-4AD8-BC31-F3D6F08A58A7\",\"pairedUUID\":\"55A7DC43-48C1-4AD8-BC31-F3D6F08A5802\",\"serialUUID\":\"55A7DC43-48C1-4AD8-BC31-F3D6F08A5801\",\"recordCommandUUID\":\"55A7DC43-48C1-4AD8-BC31-F3D6F08A5803\",\"recordingStatusUUID\":\"55A7DC43-48C1-4AD8-BC31-F3D6F08A5804\",\"recordingResultUUID\":\"55A7DC43-48C1-4AD8-BC31-F3D6F08A5805\",\"serial\":\"SNSA-TEST-001\",\"paired\":false})"},"stepId":"pw:api@34","pageId":"page@cc619240933a74a1dba6ab3f2b8f352e"}
